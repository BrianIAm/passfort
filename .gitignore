# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
.pnp.js
.yarn/install-state.gz
/.pnp
/node_modules
package-lock.json
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/src/app/development/

# misc
.DS_Store/
*.pem

# Local Notes
NOTES.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Tauri-specific ignores
# Users should run `cargo tauri icon` to generate the icons
/src-tauri/icons/
# Ignore platform-specific schema files (may cause unnecessary diffs)
/src-tauri/gen/schemas/
# Exclude large generated JSON files while keeping essential configs
/src-tauri/gen/*.json